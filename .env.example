NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox-emails

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:4000/api/slack/callback

# JSON array; multiple senders are supported. Set ETHEREAL_AUTO_CREATE=true for a demo account.
MAIL_SENDERS_JSON=[]
ETHEREAL_AUTO_CREATE=true
WORKER_CONCURRENCY=8
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MIN_SEND_INTERVAL_MS=2000
MAX_CAMPAIGN_RECIPIENTS=5000
QUEUE_DASHBOARD_PASSWORD=
